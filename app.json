{
  "expo": {
    "name": "Battlefleet",
    "slug": "battlefleet-online",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000080"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.snlimadev.battlefleet",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000080"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "08d5af3a-d212-40f3-b8d3-ad6b46c48309"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 36,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ]
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4878437225305198~1478077120"
  }
}